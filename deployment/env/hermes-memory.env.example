# Owned configuration for the hermes-memory runtime.
# Copy to $HERMES_MEMORY_HOME/hermes-memory.env and keep it mode 0600.
# Values are data, never shell. Secrets belong in the separate credential env
# file referenced by HERMES_MEMORY_*_API_KEY_ENV, not here.

# Writable root. Relative paths resolve against HERMES_MEMORY_HOME.
HERMES_MEMORY_DATA_DIR=data

# Memory inference is off until the operator opts in explicitly. There is no
# ambient provider or credential discovery: an unset route means capture and
# lexical retrieval only, which is a supported operating state.
HERMES_MEMORY_INFERENCE_ENABLED=false

# Private Hindsight API endpoint. Set this at install time; loopback or a
# literal RFC1918 address only.
HERMES_MEMORY_HINDSIGHT_URL=http://127.0.0.1:8123

# Hard allowlist of inference hosts. A configured route that is not listed
# here is a startup error, not a fallback. Only loopback and private LAN
# literals are admissible; link-local (including 169.254.169.254) is refused
# even if listed.
HERMES_MEMORY_ALLOWED_INFERENCE_HOSTS=127.0.0.1

# Name of the environment variable holding the Hindsight API key. The key
# itself lives in the credential env file, never in this one.
HERMES_MEMORY_HINDSIGHT_API_KEY_ENV=HERMES_MEMORY_HINDSIGHT_API_KEY

# Daily background generation budget in tokens. 0 keeps formation disabled;
# no value means nothing drains the archive overnight.
HERMES_MEMORY_BACKGROUND_BUDGET_TOKENS=0

# Ceiling for a foreground context packet, in seconds. Hermes abandons an
# external prefetch after 8s and a deadline at or above that is never honoured,
# so this is validated to stay strictly below it. 0, 8 and anything
# unparseable are startup errors, not fallbacks.
HERMES_MEMORY_FOREGROUND_DEADLINE_S=4

# The one principal allowed to confirm forgetting and resets. Left unset on
# purpose: with no owner named, an erasure can be previewed but never confirmed,
# which fails closed instead of accepting any caller that claims to be the
# owner. This must be a human login, never the agent's credential.
HERMES_MEMORY_OWNER_PRINCIPAL=
