# Owned configuration for the hermes-memory runtime.
# Copy to $HERMES_MEMORY_HOME/hermes-memory.env and keep it mode 0600.
# Values are data, never shell. Secrets belong in the separate credential env
# file referenced by HERMES_MEMORY_*_API_KEY_ENV, not here.

# The instance home: where this file lives, and therefore where the data directory,
# the credential file and the runtime/current release pointer are looked for. Set it in
# the environment or in the unit rather than in here — a file inside a home that names a
# different home is two installations arguing about one name.
# HERMES_MEMORY_HOME=
#
# The admission endpoint a process goes through, and the staged release it was started
# from. Both are handed over by the installer or the unit: a runtime that chose its own
# admission URL would be a second machine deciding against the first one's ledger.
# HERMES_MEMORY_ADMISSION_URL=
# HERMES_MEMORY_RELEASE=

# Writable root. Relative paths resolve against HERMES_MEMORY_HOME.
HERMES_MEMORY_DATA_DIR=data

# Memory inference is off until the operator opts in explicitly. There is no
# ambient provider or credential discovery: an unset route means capture and
# lexical retrieval only, which is a supported operating state.
HERMES_MEMORY_INFERENCE_ENABLED=false

# Private Hindsight API endpoint. Set this at install time; loopback or a
# literal RFC1918 address only. 8888 is where the backend unit binds
# (HINDSIGHT_API_PORT in hindsight.env); it is deliberately not 8123, which is
# this framework's own admission listener — the loader refuses a route that
# points at the endpoint answering it.
HERMES_MEMORY_HINDSIGHT_URL=http://127.0.0.1:8888

# Hard allowlist of inference hosts. A configured route that is not listed
# here is a startup error, not a fallback. Only loopback and private LAN
# literals are admissible; link-local (including 169.254.169.254) is refused
# even if listed.
HERMES_MEMORY_ALLOWED_INFERENCE_HOSTS=127.0.0.1

# Name of the environment variable holding the Hindsight API key. The key
# itself lives in the credential env file, never in this one.
HERMES_MEMORY_HINDSIGHT_API_KEY_ENV=HERMES_MEMORY_HINDSIGHT_API_KEY

# Model routes, one per kind of work. Each is off until its base URL is named,
# and a named URL has to be on the allowlist above or startup fails. *_RESOURCE
# says which physical device the slots are counted against (remote-9b or
# local-gpu) and *_MODEL which model to ask for; both are only consulted when
# the base URL is set. There is no ambient provider discovery and no cloud
# fallback: the route not listed here is the route that does not exist.
# HERMES_MEMORY_TEXT_BASE_URL=http://127.0.0.1:8080/v1
# HERMES_MEMORY_TEXT_RESOURCE=remote-9b
# HERMES_MEMORY_TEXT_MODEL=
# HERMES_MEMORY_VISION_BASE_URL=
# HERMES_MEMORY_VISION_RESOURCE=local-gpu
# HERMES_MEMORY_VISION_MODEL=
# HERMES_MEMORY_EMBEDDINGS_BASE_URL=
# HERMES_MEMORY_EMBEDDINGS_RESOURCE=local-gpu
# HERMES_MEMORY_EMBEDDINGS_MODEL=
# HERMES_MEMORY_RERANKER_BASE_URL=
# HERMES_MEMORY_RERANKER_RESOURCE=local-gpu
# HERMES_MEMORY_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
# Optional independent entailment judge. Unset, the verification hop runs on the
# generation route and every report says so. Set, verification presents this
# route's credential and model at the gate, so the judge and the writer are
# different admitted models; a verifier sharing the generation credential is
# refused outright.
# HERMES_MEMORY_VERIFIER_BASE_URL=
# HERMES_MEMORY_VERIFIER_RESOURCE=remote-9b
# HERMES_MEMORY_VERIFIER_MODEL=

# Longest completion each operation may ask for, in output tokens. These are
# ceilings, not targets: a response that comes back at its cap is truncated, and
# a truncated consolidation cannot claim to have seen the whole window. Anything
# outside 1..32768 is a startup error rather than a silently clipped request.
# HERMES_MEMORY_MAX_OUTPUT_TOKENS_RETAIN=2048
# HERMES_MEMORY_MAX_OUTPUT_TOKENS_CONSOLIDATE=2048
# HERMES_MEMORY_MAX_OUTPUT_TOKENS_REFLECT=2048
# HERMES_MEMORY_MAX_OUTPUT_TOKENS_FOREGROUND=1024

# Route credentials. These select which operation and which physical resource a
# request means; they are not upstream API keys, which stay at the gate. A
# configured route with no credential is refused at startup rather than served
# unauthenticated on loopback, so formation cannot run until the routes it uses
# are named here. Values are opaque tokens, one per route.
# HERMES_MEMORY_ROUTE_CREDENTIAL_RETAIN=
# HERMES_MEMORY_ROUTE_CREDENTIAL_CONSOLIDATE=
# HERMES_MEMORY_ROUTE_CREDENTIAL_REFLECT=
# HERMES_MEMORY_ROUTE_CREDENTIAL_FOREGROUND=
# HERMES_MEMORY_ROUTE_CREDENTIAL_EMBEDDINGS=
# HERMES_MEMORY_ROUTE_CREDENTIAL_VERIFIER=

# Credential the framework presents to its own admission endpoint. Unset means
# this process does not go through the gate at all, which is correct for a
# capture-only installation and wrong for anything that infers.
# HERMES_MEMORY_GATE_TOKEN=

# Daily background generation budget in tokens. 0 keeps formation disabled;
# no value means nothing drains the archive overnight.
HERMES_MEMORY_BACKGROUND_BUDGET_TOKENS=0

# Ceiling for a foreground context packet, in seconds. Hermes abandons an
# external prefetch after 8s and a deadline at or above that is never honoured,
# so this is validated to stay strictly below it. 0, 8 and anything
# unparseable are startup errors, not fallbacks.
HERMES_MEMORY_FOREGROUND_DEADLINE_S=4

# How long a background request waits for a physical model one other caller holds. One slot
# per device serialises that device; it does not turn its callers away. The engine presents
# several sub-calls of one operation at a time, so a gate that refuses on contact cannot form
# anything. 0 asks for the immediate refusal, and only suits a device with parallel slots.
HERMES_MEMORY_GATE_QUEUE_S=120

# How often the runtime process takes the background pass: due reminders, summaries a
# correction invalidated, identity candidates whose evidence is gone, the queue and what
# is still owed to a backend. The pass asks no model, takes no device slot and spends no
# budget unit, which is what makes it safe to run unattended; delivery is a separate
# question that this does not decide. 0 means nothing runs by itself and `hermes-memory
# maintain` is the operator's tool; anything above a day is refused as a typo.
HERMES_MEMORY_MAINTENANCE_INTERVAL_S=900

# The one principal allowed to confirm forgetting and resets. Left unset on
# purpose: with no owner named, an erasure can be previewed but never confirmed,
# which fails closed instead of accepting any caller that claims to be the
# owner. This must be a human login, never the agent's credential.
HERMES_MEMORY_OWNER_PRINCIPAL=

# Refuse an unevidenced memory_remember that asserts something personal about the
# owner (second-person claims). Off by default: operational notes ("queued a
# reminder") are legitimate agent writing and must not need evidence. With it on,
# such a claim is refused unless the agent cites [{record_id, quote}] evidence.
# HERMES_MEMORY_REMEMBER_STRICT=false

# Whether this installation may hand a finished draft to a transport at all.
# Off by default, and enabling it without a destination is a startup error: the
# approved address is what makes a message to another person the owner's
# decision rather than a capability the runtime has on its own. The target is
# one private channel for the owner — scheme:address, like signal:+4917… — and a
# broadcast scheme (bot-chat, all, everyone) is refused on the plan's own
# instruction, because an inbound agent turn spends the calls this avoids.
# HERMES_MEMORY_DELIVERY_ENABLED=false
# HERMES_MEMORY_DELIVERY_TARGET=
# The program that puts the message in front of the owner, for `hermes-memory
# deliver` and for the runtime's own drain. argv, no shell, a scrubbed environment — the same rule the evaluator
# runs under. `hermes send` reuses the gateway's bot credential, so the token
# stays in one place: HERMES_MEMORY_DELIVERY_COMMAND=hermes send -t telegram:123…
# --json. Without it the only destination this command can honour is local:, and
# the host's own bridge is the other caller.
# HERMES_MEMORY_DELIVERY_COMMAND=

# How often the runtime drains the outbox by itself. The background pass only
# prepares artifacts; this timer is what sends them, and it is a separate knob
# because it is the one that touches a transport. A minute, because a reminder
# that said nine means nine. Zero hands it back to the owner, who then runs
# `hermes-memory deliver` when they want something sent.
# HERMES_MEMORY_DELIVERY_POLL_S=60

# The program allowed to score a lesson against its fixtures, how long it may
# take, and which extra environment names it sees. This is the only door from a
# run to a promoted rule, so it is configuration the owner writes and never an
# argument a caller passes: an absolute path, executed without a shell, on a
# scrubbed environment. Unset means a lesson can be proposed, contradicted and
# retracted but never promoted by a run.
# HERMES_MEMORY_EVALUATOR_COMMAND=
# HERMES_MEMORY_EVALUATOR_TIMEOUT_S=120
# HERMES_MEMORY_EVALUATOR_ENV=
