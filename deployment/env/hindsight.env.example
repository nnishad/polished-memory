# Owned configuration for the Hindsight backend process.
# Copy to $HERMES_MEMORY_HOME/hindsight.env, mode 0600.
#
# These are the defaults the hermes-memory installer writes. They encode the
# measured constraints of this host: one request in flight per physical model,
# thinking disabled, grammar-constrained JSON, and local/LAN inference only.
# The plan's P0 gate requires re-measuring before these are treated as final.

# --- Concurrency: defence in depth behind the framework resource gate -------
# The LLM semaphore is process-local. Separate processes each get their own,
# which is why the worker runs with a single slot and the gate is authoritative.
HINDSIGHT_API_WORKERS=1
HINDSIGHT_API_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_RETAIN_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_REFLECT_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_CONSOLIDATION_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_EMBEDDINGS_MAX_CONCURRENT_REQUESTS=1

# API process does not also poll; the dedicated worker owns background work.
HINDSIGHT_API_WORKER_ENABLED=false
HINDSIGHT_API_WORKER_MAX_SLOTS=1
HINDSIGHT_API_WORKER_CONSOLIDATION_RESERVED_SLOTS=0

# Do not use provider-side batch execution: it issues calls outside the
# measured per-request budget path.
HINDSIGHT_API_RETAIN_BATCH_ENABLED=false

# --- Text route: remote 9B -------------------------------------------------
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=http://192.168.68.65:8080/v1
HINDSIGHT_API_LLM_MODEL=set-at-install-from-the-endpoints-model-list
HINDSIGHT_API_LLM_API_KEY=not-needed

# Grammar-constrained JSON is required for correctness on this model: with
# soft json_object the nested extraction schema emits invalid JSON and batches
# 500. This costs tokens/s and must be measured, not assumed away.
HINDSIGHT_API_LLM_STRICT_SCHEMA=true

# Thinking off: on the local 4B it consumed 256 tokens and produced zero
# characters (finish_reason=length).
HINDSIGHT_API_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# --- Output caps: the control the previous deployment lacked ---------------
# The server default is max_tokens=-1, which allowed 319,921-character
# runaway generations. Every cap below must be set from measured data; these
# placeholders are deliberately conservative.
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=2048
HINDSIGHT_API_CONSOLIDATION_MAX_COMPLETION_TOKENS=2048
HINDSIGHT_API_REFLECT_MAX_COMPLETION_TOKENS=2048

# --- Vision route: local 4B, only for chunks that carry an attachment ------
HINDSIGHT_API_VLM_PROVIDER=openai
HINDSIGHT_API_VLM_BASE_URL=http://127.0.0.1:8080/v1
HINDSIGHT_API_VLM_MODEL=set-at-install-from-the-endpoints-model-list
HINDSIGHT_API_VLM_API_KEY=not-needed

# --- Embeddings: the single local model ------------------------------------
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=qwen3-embedding:0.6b
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=ollama

# --- Ranking ---------------------------------------------------------------
# rrf is a passthrough that does no ranking work, but it is deterministic and
# evidence-preserving. A local cross-encoder may not fit the ~1.9 GiB of free
# VRAM; changing this is an owner decision, not a default.
HINDSIGHT_API_RERANKER_PROVIDER=rrf

# OCR runs through a separate OpenAI client that bypasses the LLM semaphore:
# keep it disabled until it is routed through the resource gate.
HINDSIGHT_API_FILE_PARSER_MARKITDOWN_OCR_ENABLED=false

# --- Formation -------------------------------------------------------------
# Observations come only from consolidation, which dominated cost previously.
# Kept off until the costed decision in the plan is made; the readiness check
# must then report the semantic layer as absent rather than healthy.
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=false
