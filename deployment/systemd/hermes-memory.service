[Unit]
Description=Hermes memory runtime (canonical store, context broker and resource gate)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Which release this unit runs is named by HERMES_MEMORY_RELEASE; `hermes-memory
# upgrade` plans a switch to another staged tree and performs none of it.
Environment=HERMES_MEMORY_RELEASE=@RELEASE@
Environment=HERMES_MEMORY_HOME=@INSTANCE_HOME@
WorkingDirectory=@INSTANCE_HOME@
ExecStart=@RELEASE@/bin/hermes-memory serve
ExecReload=/bin/kill -HUP $MAINPID

# Owned config, not an interactive shell's environment.
EnvironmentFile=@ENV_FILE@

Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@INSTANCE_HOME@

MemoryHigh=6G
MemoryMax=10G
TasksMax=512

[Install]
WantedBy=default.target
