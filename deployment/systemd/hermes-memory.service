[Unit]
Description=Hermes memory runtime (canonical store, context broker and resource gate)
Documentation=file:///home/jugaadu/Projects/hermes-memory/docs/operations.md
After=network-online.target hermes-memory-hindsight.service
Wants=network-online.target

[Service]
Type=simple
# Release pointer swapped atomically by `hermes-memory upgrade`.
Environment=HERMES_MEMORY_RELEASE=/home/jugaadu/services/hermes-memory/current
Environment=HERMES_MEMORY_HOME=/home/jugaadu/data/hermes-memory
ExecStart=/home/jugaadu/services/hermes-memory/current/bin/hermes-memory serve
ExecReload=/bin/kill -HUP $MAINPID

# Owned config, not an interactive shell's environment.
EnvironmentFile=/home/jugaadu/data/hermes-memory/hermes-memory.env

Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jugaadu/data/hermes-memory
# The gate must be reachable by the backend and the worker before either may
# dispatch inference, so start ordering is not optional.
NotifyAccess=main

MemoryHigh=6G
MemoryMax=10G
TasksMax=512

[Install]
WantedBy=default.target
