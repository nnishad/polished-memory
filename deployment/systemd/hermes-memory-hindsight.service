[Unit]
Description=Hindsight memory backend (API process, private loopback)
# The gate starts first: an unreachable gate means the backend cannot dispatch
# inference, and it must fail closed rather than fall back to a direct route.
After=network-online.target hermes-memory.service
Wants=hermes-memory.service

# A misconfigured engine refuses its own environment at startup, and a service that is
# restarted forever hides that in a log. Five attempts inside ten minutes, then the unit
# stays failed where `status` and `doctor` can name it.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
Environment=HERMES_MEMORY_RELEASE=@RELEASE@
Environment=HERMES_MEMORY_HOME=@INSTANCE_HOME@
WorkingDirectory=@HINDSIGHT_DATA_DIR@
ExecStart=@RELEASE@/hindsight/bin/hindsight-api

Restart=on-failure
RestartSec=10
# Cold start migrates the embedded database; keep generous.
TimeoutStartSec=900
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# One lifecycle owner for pg0: only this process initialises and migrates the
# embedded database. The worker reads its resolved DSN and never starts a
# second instance.
ReadWritePaths=@HINDSIGHT_DATA_DIR@ @PG0_DIR@
EnvironmentFile=@HINDSIGHT_ENV@
# pg0 keeps its cluster under ~/.pg0/instances/<name>/data and takes a different place
# only as a command-line flag the engine never passes, so the process is given a HOME
# inside this installation's own tree. Without it the cluster lands in the owner's real
# home, which `ProtectHome=read-only` correctly refuses - a startup failure that reads
# as a broken disk rather than as the layout decision it is.
Environment=HOME=@PG0_DIR@
Environment=HF_HOME=@INSTANCE_HOME@/cache/huggingface
Environment=TOKENIZERS_PARALLELISM=false
Environment=PYTHONDONTWRITEBYTECODE=1

MemoryHigh=8G
MemoryMax=12G
TasksMax=1024

[Install]
WantedBy=default.target
