[Unit]
Description=Hindsight background worker (single slot, gate-serialised)
After=hermes-memory-hindsight.service
BindsTo=hermes-memory-hindsight.service
PartOf=hermes-memory-hindsight.service

[Service]
Type=simple
Environment=HERMES_MEMORY_RELEASE=@RELEASE@
Environment=HERMES_MEMORY_HOME=@INSTANCE_HOME@
WorkingDirectory=@HINDSIGHT_DATA_DIR@
ExecStart=@RELEASE@/hindsight/bin/hindsight-worker

Restart=on-failure
RestartSec=15
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HINDSIGHT_DATA_DIR@ @PG0_DIR@
EnvironmentFile=@HINDSIGHT_ENV@
Environment=PG0_HOME=@PG0_DIR@
Environment=PYTHONDONTWRITEBYTECODE=1

# One slot only. Native reservations are floors, not ceilings, so a default
# reservation of two against one total slot would deadlock retain behind
# consolidation.
Environment=HINDSIGHT_API_WORKER_MAX_SLOTS=1
Environment=HINDSIGHT_API_WORKER_CONSOLIDATION_RESERVED_SLOTS=0

MemoryHigh=6G
MemoryMax=10G
TasksMax=256

[Install]
WantedBy=default.target
