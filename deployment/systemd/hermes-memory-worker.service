[Unit]
Description=Hindsight background worker (single slot, gate-serialised)
After=hermes-memory-hindsight.service
BindsTo=hermes-memory-hindsight.service
PartOf=hermes-memory-hindsight.service

# A misconfigured engine refuses its own environment at startup, and a service that is
# restarted forever hides that in a log. Five attempts inside ten minutes, then the unit
# stays failed where `status` and `doctor` can name it.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
Environment=HERMES_MEMORY_RELEASE=@RELEASE@
Environment=HERMES_MEMORY_HOME=@INSTANCE_HOME@
WorkingDirectory=@HINDSIGHT_DATA_DIR@
# Our launcher, not the distribution's own script: §8.1.2 needs the operation
# identity, the bank it belongs to and the cancellation state written down before
# the engine is asked to run anything, and that wrapper has to be in the process.
# hindsight_api is imported from this environment, which is why the framework
# package carries no dependencies of its own.
ExecStart=@RELEASE@/hindsight/bin/python -m hermes_memory.backend.worker_launcher

Restart=on-failure
RestartSec=15
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The instance home holds the admission ledger this worker writes its operation
# records into; without it the wrapper would fail on its first write under
# ProtectSystem=strict.
ReadWritePaths=@INSTANCE_HOME@ @HINDSIGHT_DATA_DIR@ @PG0_DIR@
EnvironmentFile=@HINDSIGHT_ENV@
Environment=PG0_HOME=@PG0_DIR@
Environment=PYTHONDONTWRITEBYTECODE=1

# One slot only. Native reservations are floors, not ceilings, so a default
# reservation of two against one total slot would deadlock retain behind
# consolidation.
Environment=HINDSIGHT_API_WORKER_MAX_SLOTS=1
Environment=HINDSIGHT_API_WORKER_CONSOLIDATION_RESERVED_SLOTS=0

MemoryHigh=6G
MemoryMax=10G
TasksMax=256

[Install]
WantedBy=default.target
