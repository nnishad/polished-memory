[Unit]
Description=Hindsight background worker (single slot, gate-serialised)
Documentation=file:///home/jugaadu/Projects/hermes-memory/docs/operations.md
After=hermes-memory-hindsight.service
BindsTo=hermes-memory-hindsight.service
PartOf=hermes-memory-hindsight.service

[Service]
Type=simple
Environment=HERMES_MEMORY_RELEASE=/home/jugaadu/services/hermes-memory/current
Environment=HERMES_MEMORY_HOME=/home/jugaadu/data/hermes-memory
ExecStart=/home/jugaadu/services/hermes-memory/hindsight/current/bin/hindsight-worker

Restart=on-failure
RestartSec=15
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jugaadu/data/hermes-memory/hindsight /home/jugaadu/data/hermes-memory/pg0
EnvironmentFile=/home/jugaadu/data/hermes-memory/hindsight.env
Environment=PYTHONDONTWRITEBYTECODE=1

# One slot only. Native reservations are floors, not ceilings, so a default
# reservation of two against one total slot would deadlock retain behind
# consolidation.
Environment=HINDSIGHT_API_WORKER_MAX_SLOTS=1
Environment=HINDSIGHT_API_WORKER_CONSOLIDATION_RESERVED_SLOTS=0

MemoryHigh=6G
MemoryMax=10G
TasksMax=256

[Install]
WantedBy=default.target
